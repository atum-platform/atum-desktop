{
  "name": "hermes-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/shared",
    "packages/atum-kit",
    "packages/browser-client",
    "packages/device-protocol",
    "ui-tui",
    "ui-tui/packages/*",
    "web",
    "packages/model-client",
    "packages/model-client",
    "packages/model-client"
  ],
  "scripts": {
    "postinstall": "echo '\u2705 Node dependencies installed. Run: python run_agent.py --help'",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace ui-tui",
    "demo:build": "npm run pack:prod --workspace apps/desktop -- --demo-dmg",
    "demo:preflight": "node scripts/demo-canon-check.mjs",
    "check": "npm run --ws check",
    "fix": "npm run --ws fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/atum-platform/atum-app"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/NousResearch/Hermes-Agent/issues"
  },
  "homepage": "https://github.com/NousResearch/Hermes-Agent#readme",
  "dependencies": {
    "@streamdown/math": "^1.0.2",
    "agent-browser": "0.26.0",
    "js-yaml": "4.3.2",
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-plugin-perfectionist": "5.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0"
  },
  "overrides": {
    "electron-updater": {
      "builder-util-runtime": "9.7.0"
    },
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    },
    "lodash": "4.18.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.12",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "mermaid": "11.16.1",
    "dompurify": "3.4.17",
    "ip-address": "10.7.4",
    "nanoid@^3": "3.3.20",
    "nanoid@^6": "6.0.0",
    "js-yaml@^4": "4.3.2",
    "undici@^6": "6.29.1",
    "undici@^7": "7.30.1",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "tar": "7.5.22",
    "source-map-js": "1.2.2",
    "yaml": "2.9.1",
    "vitest": "4.1.12",
    "@vitest/mocker": "4.1.12",
    "yauzl": "^3.3.1",
    "katex": "0.18.2",
    "zod": "4.6.6",
    "minimatch@9": "11.0.1",
    "minimatch@10": "11.0.1"
  },
  "engines": {
    "node": "^22.22.0 || ^24.11.0 || >=26.0.0",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "@sentry/cli@3.7.0": true,
    "electron@44.10.1": true,
    "unicode-animations": false,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "get-windows@9.3.0": true,
    "agent-browser@0.26.0": true
  }
}
