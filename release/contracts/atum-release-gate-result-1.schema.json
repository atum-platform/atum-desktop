{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atum.app/contracts/atum-release-gate-result-1.schema.json",
  "title": "Atum required release gate result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gate_id", "candidate_id", "source_head_sha", "artifact_sha256s", "result", "completed_at", "valid_until", "evidence_ref"],
  "properties": {
    "schema": {"const": "atum-release-gate-result/1"},
    "gate_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "result": {"enum": ["pass", "fail", "blocked", "cancelled", "skipped"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "evidence_ref": {"type": "string", "minLength": 1}
  }
}
