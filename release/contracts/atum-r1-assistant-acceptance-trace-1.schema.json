{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atum.app/contracts/atum-r1-assistant-acceptance-trace-1.schema.json",
  "title": "Atum R1 assistant acceptance trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "source_head_sha",
    "artifact_sha256",
    "journey_id",
    "fixture_id",
    "target",
    "execution",
    "started_at",
    "completed_at",
    "valid_until",
    "browser",
    "computer_control",
    "redaction_check",
    "evidence_ref"
  ],
  "properties": {
    "schema": {"const": "atum-r1-assistant-acceptance-trace/1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "source_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "journey_id": {"const": "R1-assistant-completion"},
    "fixture_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "arch"],
      "properties": {
        "os": {"enum": ["macos", "windows", "linux"]},
        "os_version": {"type": "string", "minLength": 1},
        "arch": {"enum": ["arm64", "x64"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "clean_install",
        "isolated_profile",
        "deployment_credentials_used",
        "github_ruleset_access_used"
      ],
      "properties": {
        "mode": {"enum": ["local", "packaged"]},
        "clean_install": {"type": "boolean"},
        "isolated_profile": {"type": "boolean"},
        "deployment_credentials_used": {"const": false},
        "github_ruleset_access_used": {"const": false}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentations", "without_grant"],
      "properties": {
        "presentations": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "pane_opened_automatically",
              "technical_detail_available",
              "evidence"
            ],
            "properties": {
              "state": {"enum": ["pending", "slow", "success", "error", "cancelled"]},
              "pane_opened_automatically": {"type": "boolean"},
              "technical_detail_available": {"type": "boolean"},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "without_grant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["broker_decision", "problem_code", "attempted_effects", "authority_ref", "evidence"],
          "properties": {
            "broker_decision": {"const": "denied"},
            "problem_code": {"enum": ["CAPABILITY_DENIED", "CAPABILITY_REVOKED"]},
            "attempted_effects": {"type": "integer", "minimum": 0},
            "authority_ref": {"type": "null"},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "computer_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disclosure", "initial_choices", "grant", "active_use", "revocations", "safe_boundary", "subsequent_attempt"],
      "properties": {
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capability", "scope", "effect", "presented_before_decision", "evidence"],
          "properties": {
            "capability": {"const": "computer_control"},
            "scope": {"type": "string", "minLength": 1},
            "effect": {"type": "string", "minLength": 1},
            "presented_before_decision": {"type": "boolean"},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "initial_choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision", "attempted_effects", "authority_ref", "evidence"],
            "properties": {
              "decision": {"enum": ["denied", "later"]},
              "attempted_effects": {"type": "integer", "minimum": 0},
              "authority_ref": {"type": "null"},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "broker", "authority_ref", "scope", "evidence"],
          "properties": {
            "decision": {"const": "granted"},
            "broker": {"const": "S2"},
            "authority_ref": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "active_use": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible", "capability", "authority_ref", "attribution", "evidence"],
          "properties": {
            "visible": {"type": "boolean"},
            "capability": {"const": "computer_control"},
            "authority_ref": {"type": "string", "minLength": 1},
            "attribution": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "revocations": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "broker", "authority_ref", "decision", "evidence"],
            "properties": {
              "source": {"enum": ["live_surface", "settings"]},
              "broker": {"const": "S2"},
              "authority_ref": {"type": "string", "minLength": 1},
              "decision": {"const": "revoked"},
              "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "safe_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "use_started",
            "revocation",
            "use_finished",
            "problem_code",
            "technical_detail_available",
            "technical_detail",
            "detail_sanitized",
            "evidence"
          ],
          "properties": {
            "use_started": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "grantId", "operationId", "occurredAt", "observed_order"],
              "properties": {
                "type": {"const": "use_started"},
                "grantId": {"type": "string", "minLength": 1},
                "operationId": {"type": "string", "minLength": 1},
                "occurredAt": {"type": "string", "format": "date-time"},
                "observed_order": {"type": "integer", "minimum": 0}
              }
            },
            "revocation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "grantId", "safeBoundary", "rendererMessage", "occurredAt", "observed_order"],
              "properties": {
                "type": {"const": "revoked"},
                "grantId": {"type": "string", "minLength": 1},
                "safeBoundary": {"const": "partial_effects"},
                "rendererMessage": {"type": "string", "minLength": 1},
                "occurredAt": {"type": "string", "format": "date-time"},
                "observed_order": {"type": "integer", "minimum": 0}
              }
            },
            "use_finished": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "grantId",
                "operationId",
                "outcome",
                "safeBoundary",
                "completedOperation",
                "rendererMessage",
                "occurredAt",
                "observed_order"
              ],
              "properties": {
                "type": {"const": "use_finished"},
                "grantId": {"type": "string", "minLength": 1},
                "operationId": {"type": "string", "minLength": 1},
                "outcome": {"const": "revoked"},
                "safeBoundary": {"const": "partial_effects"},
                "completedOperation": {"type": "boolean"},
                "rendererMessage": {"type": "string", "minLength": 1},
                "occurredAt": {"type": "string", "format": "date-time"},
                "observed_order": {"type": "integer", "minimum": 0}
              }
            },
            "problem_code": {"const": "CAPABILITY_REVOKED"},
            "technical_detail_available": {"const": true},
            "technical_detail": {"type": "string", "minLength": 1},
            "detail_sanitized": {"const": true},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "subsequent_attempt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["broker_decision", "problem_code", "attempted_effects", "authority_ref", "evidence"],
          "properties": {
            "broker_decision": {"const": "denied"},
            "problem_code": {"enum": ["CAPABILITY_DENIED", "CAPABILITY_REVOKED"]},
            "attempted_effects": {"type": "integer", "minimum": 0},
            "authority_ref": {"type": "null"},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "redaction_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "corpus_result_ref", "result"],
      "properties": {
        "verifier": {"type": "string", "minLength": 1},
        "corpus_result_ref": {"type": "string", "minLength": 1},
        "result": {"const": "pass"}
      }
    },
    "evidence_ref": {"type": "string", "minLength": 1}
  }
}
