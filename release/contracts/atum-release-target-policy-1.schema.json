{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atum.app/contracts/atum-release-target-policy-1.schema.json",
  "title": "Atum supported release targets v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "support_window_days", "targets"],
  "properties": {
    "schema": {"const": "atum-release-target-policy/1"},
    "policy_id": {"type": "string", "minLength": 1},
    "support_window_days": {"type": "integer", "minimum": 1},
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_id", "os", "os_min", "arch", "format"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "os": {"enum": ["macos", "windows", "linux"]},
          "os_min": {"type": "string", "minLength": 1},
          "arch": {"enum": ["arm64", "x64"]},
          "format": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
