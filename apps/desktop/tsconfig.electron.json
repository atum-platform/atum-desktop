{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "ignoreDeprecations": "6.0",
    "composite": true,
    "rootDir": "../..",
    "declaration": true,
    "outDir": "build/electron-types"
  },
  // electron/docx-extract.ts converts OOXML in the MAIN process and shares the
  // pure converter with the renderer. The managed-model proxy likewise shares
  // one DOM-free response validator with the renderer. A composite project
  // must list every file it compiles, so an import alone is not enough.
  // The cross-process document lifecycle test also compiles the DOM-free rich
  // transaction adapter against the actual file lease and export services.
  // The Matrix SDK seam's contract and command queue are DOM-free too: the main process
  // keeps one queue per SDK window, and browser and headless hosts share it (G8-36).
