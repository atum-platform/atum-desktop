  "rules": {
    "account_data": {
      "policy_type": "io.atum.room.agents",
      "usage_type": "io.atum.room.usage",
      "scope": "owner private per-room account data, never room state",
      "writer": "owner SDK only",
      "unknown_keys": "preserve on write, including agent-entry speak and consentEpoch; they confer no authority"
    },
    "policy_validation": "Validate every agents map key as a Matrix user ID and each value using agent_entry. The generic checker cannot express dynamic object values: consumer tests must validate entries. Malformed known values fail closed; never treat an invalid mode as a missing entry.",
    "effective_mode": "Missing meeting entry uses MATRIX_MEETING_DEFAULT=addressed until migration 0200 is live with owner approval, then joins. Missing shared entry is addressed. Shared ceiling maps stored joins to addressed; off remains off.",
    "trigger": "Only verified top-level owner text. Off is none. Explicit own-assistant mentions win over replies; X named only if mentioned, else none when any own assistant named. Otherwise reply to own assistant names only that assistant. Plain meeting text is everyone only for joins; shared plain text never triggers. m.mentions.room and body-text inference are not triggers.",
    "floor": {
      "algorithm": "Everyone: SHA-256 of UTF-8(eventId + \":\" + agentUserId), ascending digest, userId tie-break; first two joined joins candidates. Named: eligible mentioned assistants in mention order, or reply target if no own assistant is mentioned. Eligibility/policy re-read before claim. No candidate no claim.",
      "EVERYONE_ANSWERS_MAX": 2,
      "FLOOR_WAIT_MS": 180000,
      "pollMs": 2000,
      "FLOOR_MAX_AGE_MS": 330000,
      "freshnessMs": 120000
    },
    "settled": "Earlier verified m.text or m.notice must reply to owner trigger event. Waiting emits no typing; run after bounded wait even if predecessor Mac is away. Membership change invalidates. Per-room Mac serial queue prevents simultaneous local model calls.",
    "freshness": "Position >0 only, acceptedAt >= timestamp, acceptedAt <= now, acceptedAt-timestamp <=120000 AND now-timestamp <=330000. Otherwise 120000 age bound; future timestamps are refused. Re-read at pre-dispatch.",
    "cap": {
      "unit": "answers claimed per room per UTC day, including named and chain turns",
      "default": 30,
      "min": 1,
      "max": 200,
      "authority": "client account data early check is advisory; migration 0200 atomically caps ledger claims across agents/Macs, with hold; refuse room_cap before charging",
      "notice": "First floor agent publishes once per room UTC day; raising cap resumes; named messages never bypass",
      "rollover": "A different valid UTC day resets turns and pausedNoticed"
    },
    "chain": {
      "key": "io.atum.chain (io.atum.turn remains local-turn marker)",
      "CHAIN_DEPTH_MAX": 3,
      "CHAIN_TURNS_MAX": 6,
      "originAgeMs": 600000,
      "verification": "Read actual events via owner SDK; room/verified sender/member authority independent of content. Walk current event parent to owner origin; stamp depth must equal actual number of assistant events; each stamped origin same, parent in same room, max three; reject cycles/missing/foreign/untrusted/stale/future/repeat target/origin cap/daily cap. Origin is real verified owner top-level text; chain explicitly names next own assistant. Chain sender is a narrow meeting-only exception to E.3, never shared.",
      "publication": "Owner reply stamps depth 1 and parent owner origin. Child reply stamps depth+1 and parent current assistant event only below depth 3. Each assistant event ID claimed once; origin/depth binding enforced by 0200.",
      "result_depth": "chain_result.depth is the validated CURRENT incoming assistant event stamp depth, not the responding agent next stamp. A child reply may publish depth+1 only when current depth<3. At incoming depth 3 it may reply without forwarding a new chain stamp.",
      "ledger_facts": "originTurns and spokenAgentIds are read from authoritative per-origin admitted claims, never client content. A chain requires at least one admitted origin turn (originTurns>=1); zero turns is invalid_chain. The walked origin owner text must have actually started the admitted chain."
    },
    "profiles": {
      "interaction_table": "Eight profile.scenario fixtures are normative. reply_only has no tools or memory, including pet; shared_room ceiling never widens and has no pet tool; pet_surface permits the pet tool only on an otherwise standard private session under Plan 3 host reply handshake. All flag combinations have distinct fixed keys. Shared chain intake remains refused.",
      "toolsets": "No terminal, files, code, web, browser, memory, session_search, skills, Google, cron, MCP, messaging, delegation or sending in reply_only; background tasks equally constrained. Resume across any profile combination refused.",
      "conversation_key": "Existing (agent, device, owner, room, mode, audience) plus reply_only and pet_surface; shared bit already follows mode; schema key is the profile suffix only, not a replacement identity. No toolset change inside conversation.",
      "implementation_order": "Plan 3 PT-10a -> Plan 1 slice 6 -> Plan 3 PT-10b, one server.py claim and combined test. Host must not declare a group room a pet surface; pet intents never publish in group/shared replies."
    },
    "disclosure": "No join notice in meeting rooms. Before first shared answer after audience change post existing five-locale groupJoined, then persist disclosedAudience with link. Unchanged audience no repeat. Offline membership change still detected at next turn.",
    "room_port": [
      "readMembers",
      "readPolicy",
      "readRecent",
      "readSettled",
      "readOwnerEvent",
      "publish"
    ],
    "release_gate": "Keep MATRIX_MEETING_DEFAULT addressed until 0200 applied with owner go and gateway proof. Slices 3+4 ship together. CLOUD_GROUP_ROOMS default off. shareGroupKeys legacy guard/deletion condition belongs only to Plan 5 P5-5/P5-6 interop matrix."
  },
