{
  "input": {
    "roomId": "!meeting:example.invalid",
    "viewerAgentId": "@assistant-a:example.invalid",
    "excludeEventId": "$trigger",
    "window": "meeting",
    "limits": {
      "messages": 50,
      "chars": 2,
      "pages": 3,
      "deadlineMs": 8000
    }
  },
  "roomMode": "meeting",
  "events": [
    {
      "eventId": "$answer",
      "senderRef": "@assistant-b:example.invalid",
      "displayName": "Assistant B",
      "at": 1300,
      "verified": true,
      "decrypted": true,
      "msgtype": "m.text",
      "text": "🐾á",
      "trust": "own_assistant"
    },
    {
      "eventId": "$trigger",
      "senderRef": "@owner:example.invalid",
      "displayName": "Owner",
      "at": 1400,
      "verified": true,
      "decrypted": true,
      "msgtype": "m.text",
      "text": "What do you think?",
      "trust": "owner"
    }
  ],
  "expected": {
    "status": "ok",
    "lines": [
      {
        "eventId": "$answer",
        "senderRef": "@assistant-b:example.invalid",
        "displayName": "Assistant B",
        "trust": "own_assistant",
        "text": "🐾á",
        "at": 1300
      }
    ],
    "gaps": 0,
    "omitted": 0
  }
}
