  "consumers": [
    "desktop pet stage",
    "future native pet stage"
  ],
  "types": {
    "pet.command": {
      "anyOf": [
        {
          "type": "object",
          "required": {
            "action": {
              "const": "go"
            },
            "place": {
              "enum": [
                "left",
                "right",
                "center"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": {
            "action": {
              "enum": [
                "wave",
                "jump",
                "sit",
                "lounge"
              ]
            }
          }
        }
      ]
    },
    "pet.mixin": {
      "type": "object",
      "required": {
        "v": {
          "const": 1
        },
        "intents": {
          "type": "array",
          "items": {
            "ref": "pet.command"
          },
          "min": 1,
          "max": 3
        }
      }
    }
  },
  "directions": {
    "agent_pet_mixin": {
      "description": "Only the cosmetic io.atum.pet value; identity and geometry come from the room and pet stage.",
      "forbidden_fields": [
        "x",
        "y",
        "coordinates",
        "targetX",
        "targetY",
        "text",
        "body",
        "url",
        "petId",
        "pet_id",
        "slug",
        "agentPrincipal",
        "roomId"
      ]
    },
    "agent_reply_to_private_room": {
      "description": "Ordinary encrypted m.text reply from the room\u2019s own assistant; no standalone pet event.",
      "forbidden_fields": []
    }
  },
  "messages": {
    "pet.mixin": {
      "direction": "agent_pet_mixin",
      "schema": {
        "ref": "pet.mixin"
      }
    },
    "pet.reply_content": {
      "direction": "agent_reply_to_private_room",
      "schema": {
        "type": "object",
        "required": {
          "msgtype": {
            "const": "m.text"
          },
          "body": {
            "type": "string",
            "min": 1
          },
          "io.atum.pet": {
            "ref": "pet.mixin"
          }
        },
        "additional": true
      }
    }
  },
  "invariants": [],
