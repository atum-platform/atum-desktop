  "base": {
    "contract": "atum.company-workspace/1.2",
    "path": "spec/company-workspace/v1.2",
    "kind": "pack",
    "sha256": "0fc711022a043c94594390092a9579b41cc2ee420a798efcb7e515487ff58e7c",
    "rule": "additive minor version; 1.1 schema 2 and 1.2 schema 3 messages remain byte-identical; only 1.3 messages use schema 4"
  },
  "selection": {
    "header": "Atum-Company-Wire",
    "value": "1.3",
    "accepted_values": {
      "1": "v1 byte-identical",
      "1.1": "v1.1 byte-identical",
      "1.2": "v1.2 byte-identical",
      "1.3": "v1.2 plus C1 messages"
    },
    "absent": "v1 byte-identical",
    "unknown_value": "400 matrix_400, no effect",
    "vary": "Atum-Company-Wire",
    "cache": "no-store",
    "response_marker": {
      "field": "schemaVersion",
      "v1": 1,
      "v1_1": 2,
      "v1_2": 3,
      "v1_3": 4,
      "scope": "new C1 messages only"
    }
  },
  "authority": {
    "owner": "exactly one active human owner in every nonempty company; old wires project owner as admin",
    "transfer": "atomic under target-person quota then company lock; target active human; former owner stays admin; authority generation and audit advance",
    "admin_boundary": "admins cannot alter owner or another admin; owner-only admin promotion/demotion; rank never grants private audience",
    "admission_epoch": "stable memberRef plus a monotonically increasing internal admission epoch; readmission restores no restricted grant",
    "locks": "accept/create with reserved capacity, ownership transfer and role change acquire target-person quota then company, then invitation/link where applicable"
  },
  "invitations": {
    "expiry_seconds": 604800,
    "machine": "pending to accepted, declined, cancelled, expired or superseded",
    "resend": "fresh invitation id and expiry; old pending attempt becomes superseded; replay returns same replacement",
    "enforcement": "expiry checked on reads and acceptance; sweeper is cleanup only; legacy routes use current terminal checks",
    "migration": "an existing pending invitation without expiresAt receives expiresAt = migration time + 604800 seconds",
    "email": "not supported until a verified-email assertion contract exists; use handle or copy invite link"
  },
  "capabilities": {
    "authenticated": true,
    "mutation_rule": "clients never downgrade and retry a mutation after an ambiguous result",
    "activation": "feature support, tenant activation and room-controller readiness are distinct fields"
  },
  "replay": {
    "scope": "(actor, requestId)",
    "changed_input": "409 and no effect",
    "cross_actor": "409 and no stored receipt disclosure",
    "reauthorization": "current privilege rechecked except narrow self receipts: a former owner may replay their own completed ownership transfer and an invitee may confirm their own accept/decline",
    "removal": "replay never revives membership or a terminal invitation"
  },
  "policy_update": {
    "authority": "owner or active admin per Decision 3",
    "generation": "expectedAuthorityGeneration is required; success advances authorityGeneration",
    "replay": "(actor, requestId), immutable policy input and current authority",
    "effect": "channelCreation members (default) or admins_only affects future channel creation only; existing channels and admissions are unchanged",
    "audit": "record actor, old/new policy and generations without message content or credentials"
  },
  "authority_generation": {
    "bumps": [
      "membership admission/revocation commit",
      "role change",
      "ownership transfer",
      "policy update"
    ],
    "stable": [
      "invitation create",
      "decline",
      "cancel",
      "expire",
      "resend until membership acceptance"
    ],
    "invitee_projection": "invitation responses do not expose company authorityGeneration to an invitee; admin-only mutation responses may carry it"
  },
  "audience": {
    "member": "own role/policy and own invitations",
    "admin": "authorized roster and invitation history",
    "owner": "admin audience plus owner-only controls",
    "invitee": "own attempt plus bounded inviter/company projection",
    "outsider": "nothing; guessed ids normalize"
  },
  "audit": {
    "events": [
      "membership",
      "role",
      "ownership",
      "policy",
      "invitation"
    ],
    "excludes": [
      "message content",
      "bearer tokens",
      "email address",
      "Matrix credentials",
      "provider errors"
    ]
  },
  "compatibility": {
    "old_owner_projection": "owner is admin",
    "old_invitation_projection": "pending attempt only",
    "shared_enforcement": "legacy routes cannot remove owner, accept terminal attempt, or grant admin by ordinary admin",
    "error_mapping": {
      "owner_transfer_required": "1.1/1.2 last_admin body",
      "owner_generation_conflict": "plain matrix_409",
      "role_change_forbidden": "plain matrix_409",
