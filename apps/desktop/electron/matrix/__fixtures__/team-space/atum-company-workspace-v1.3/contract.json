  "row": "C1 Team administration: single owner, roles, invitation attempts, capabilities and audit",
  "providers": [
    "Atum platform company authority and Shell native routes"
  ],
  "consumers": [
    "Atum desktop Team Space",
    "Atum phone Team Space",
    "hosted room controller capability gate"
