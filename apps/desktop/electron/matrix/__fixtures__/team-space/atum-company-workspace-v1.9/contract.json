  "capability": {
    "name": "company.email-invitations",
    "emailInvitations": true,
    "emailAutoClaim": [
      "active",
      "verification_required"
    ],
    "fail_closed_default": "verification_required"
  },
  "privacy": {
    "directory_hidden": "verified_match with hidden visibility; invitation resolution still uses the account",
    "absent": "only a complete authoritative MAS lookup with zero matches",
    "outward_acknowledgement": "identical accepted response"
  },
  "verification": {
    "list_resource_is_proof": false,
    "accepted_proofs": [
      "password_registration",
      "upstream_verified_claim",
      "privileged_verified_assertion"
    ],
    "unproven_behavior": "fail closed; never absent; no automatic claim"
  },
  "legacy": {
    "preview": "email_invite_claim_required",
    "redeem": "email_invite_claim_required",
    "rule": "email-bound links never use bearer redemption; ordinary share links are unchanged"
  },
  "lifecycle": {
    "expiry_seconds": 604800,
    "role": "member",
    "uses": 1,
    "no_click_claim": true,
    "p1_mail": "private durable outbox only; no sender"
  },
  "types": {
    "uuid": {
      "type": "string",
      "min": 36,
      "max": 36,
      "pattern": "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
    },
    "email": {
      "type": "string",
      "min": 3,
      "max": 254,
      "pattern": "[^\\s@]+@[^\\s@]+\\.[^\\s@]+"
    },
    "epoch": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "fingerprint": {
      "type": "string",
      "min": 66,
      "max": 66,
      "pattern": "\\\\x[0-9a-f]{64}"
    },
    "create_request": {
      "type": "object",
      "required": {
        "requestId": {
          "ref": "uuid"
        },
        "email": {
          "ref": "email"
        },
        "locale": {
          "enum": [
            "vi",
            "en"
          ]
        }
      }
    },
    "create_response": {
      "type": "object",
      "required": {
        "schemaVersion": {
          "const": 10
        },
        "invitationId": {
          "ref": "uuid"
        },
        "state": {
          "const": "accepted"
        },
        "mailStatus": {
          "const": "accepted"
        },
        "expiresAt": {
          "ref": "epoch"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "claim_request": {
      "type": "object",
      "required": {
        "requestId": {
          "ref": "uuid"
        }
      }
    },
    "verified_fact": {
      "type": "object",
      "required": {
        "issuer": {
          "type": "string",
          "min": 1,
          "max": 2048
        },
        "masUser": {
          "type": "string",
          "min": 26,
          "max": 26
        },
        "matrixUser": {
          "type": "string",
          "min": 4,
          "max": 520
        },
        "fingerprint": {
          "ref": "fingerprint"
        },
        "fingerprintKeyVersion": {
          "type": "integer",
          "min": 1,
          "max": 255
        },
        "proof": {
          "enum": [
            "password_registration",
            "upstream_verified_claim",
            "privileged_verified_assertion"
          ]
        }
      }
    },
    "resolution_match": {
      "type": "object",
      "required": {
        "state": {
          "const": "verified_match"
        },
        "fact": {
          "ref": "verified_fact"
        },
        "directoryVisibility": {
          "enum": [
            "visible",
            "hidden"
          ]
        }
      }
    },
    "resolution_absent": {
      "type": "object",
      "required": {
        "state": {
          "const": "absent"
        }
      }
    },
    "legacy_refusal": {
      "type": "object",
      "required": {
        "error": {
          "const": "matrix_409"
        },
        "details": {
          "type": "object",
          "required": {
            "reason": {
              "const": "email_invite_claim_required"
            },
            "retryable": {
              "const": false
            }
          }
        }
      }
    }
  },
  "directions": {
