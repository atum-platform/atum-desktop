    "company_name": {
      "type": "string",
      "min": 1,
      "max": 120
    },
    "topic": {
      "type": "string",
      "min": 0,
      "max": 250
    },
    "purpose": {
      "type": "string",
      "min": 0,
      "max": 500
    },
    "channel_state": {
      "enum": [
        "provisioning",
        "active",
        "archived"
      ]
    },
    "public_summary": {
      "type": "object",
      "required": {
        "id": {
          "ref": "uuid"
        },
        "companyId": {
          "ref": "uuid"
        },
        "displayName": {
          "ref": "channel_name"
        },
        "visibility": {
          "const": "public"
        },
        "topic": {
          "ref": "topic"
        },
        "purpose": {
          "ref": "purpose"
        },
        "state": {
          "ref": "channel_state"
        },
        "memberCount": {
          "type": "integer",
          "min": 0,
          "max": 100
        },
        "joined": {
          "type": "boolean"
        },
        "channelGeneration": {
          "ref": "generation"
        }
      },
      "optional": {
        "systemKey": {
          "const": "default"
        }
      }
    },
    "browse_response": {
      "type": "object",
      "required": {
        "schemaVersion": {
          "const": 7
        },
        "channels": {
          "type": "array",
          "items": {
            "ref": "public_summary"
          },
          "min": 0,
          "max": 100,
          "unique": true
        }
      }
    },
    "invitation_summary": {
      "type": "object",
      "required": {
        "id": {
          "ref": "uuid"
        },
        "companyId": {
          "ref": "uuid"
        },
        "companyDisplayName": {
          "ref": "company_name"
        },
        "role": {
          "enum": [
            "admin",
            "member"
          ]
        },
        "expiresAt": {
          "ref": "epoch"
        }
      }
    },
    "invitation_directory": {
      "type": "object",
      "required": {
        "schemaVersion": {
          "const": 7
        },
        "invitations": {
          "type": "array",
          "items": {
            "ref": "invitation_summary"
          },
          "min": 0,
          "max": 100,
          "unique": true
        }
      }
    }
  },
  "directions": {
    "platform_to_native_v1_6": {
      "from": "Atum platform",
      "to": "authenticated native client",
      "forbidden_fields": [
