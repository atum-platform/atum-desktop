    "actor": "resolved authenticated caller; never client input",
    "rpc": "SECURITY DEFINER, search_path pg_catalog and pg_temp, service-role Shell only",
    "cache": "no-store"
  },
  "types": {
    "uuid": {
      "type": "string",
      "min": 36,
      "max": 36,
      "pattern": "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
    },
    "generation": {
      "type": "integer",
      "min": 1,
      "max": 9007199254740991
