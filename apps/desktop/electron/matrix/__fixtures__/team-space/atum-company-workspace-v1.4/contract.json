  "authority": {
    "key": "(company, channel, member, membershipAdmissionEpoch)",
    "prerequisite": "active company membership at matching epoch",
    "non_grants": [
      "Matrix membership",
      "room id",
      "cached directory",
      "project association",
      "admin rank"
    ],
    "visibility": "immutable; update_metadata may carry visibility only so the server can compare it to stored visibility and return channel_visibility_immutable on change",
    "manager": "hosted manager provisions every room; clients never do",
    "moderation": "creator is immutable channel owner; channel owner and admitted active company admins may invite/remove/archive, but admin rank without admission grants no metadata or action"
  },
  "audience": {
    "effective": "active company membership AND matching current membership admission epoch AND active channel admission",
    "public_browse": "active company members receive bounded public metadata only",
    "private": "non-admitted users receive no metadata, count, existence, search, file, preview, notification or room binding",
    "admin": "rank does not grant private access"
  },
  "default_channel": {
    "systemKey": "default",
    "rules": [
      "public",
      "auto-admitted",
      "cannot leave",
      "cannot remove independently",
      "cannot archive except company retirement",
      "cannot change visibility"
    ],
    "legacy_enforcement": true
  },
  "migration": {
    "existing": "all company-wide channels become public forever with active-member admission backfill",
    "preserve": [
      "channel UUID",
      "room binding",
      "immutable create event",
      "history",
      "file references"
    ],
    "private": "new channel and room; no history/file copy",
    "new_members": "default channel only",
    "pending_invitations": "any existing pending channel invitation without expiresAt receives migration time + 604800 seconds"
  },
  "admissions": {
    "reentry": "left/removed advances to a new none row/generation; public then self-joins, private requires a fresh pending invitation and accept",
    "public_removal": "not a durable ban; after witnessed removal and a fresh none generation an active company member may self-join again",
    "invitations": "pending invitation expires after 604800 seconds and may be accepted or self-declined, admin-cancelled, or synchronously expired; decline/cancel/expire move admission to revoking and require possible-grant ban witnesses before none; every terminal attempt is immutable",
    "members_read": "admitted moderators receive memberRef plus admission state/generations; revoking remains visible as pending cleanup"
  },
  "concurrency": {
    "rule": "every 1.4 mutation except create requires expectedChannelGeneration; admission mutations also require expectedAdmissionGeneration; stale values return admission_generation_conflict and never last-write-wins",
    "legacy_routes": "1.1 create/archive/restore only; archive/restore read current generation under the channel lock and apply against it, while newer mutations fail closed on the legacy error surface"
  },
  "replay": {
    "scope": "(actor, requestId)",
    "reauthorize": true,
    "changed_input": "409 no effect",
    "cross_actor": "409 no stored receipt disclosure"
  },
  "compatibility": {
    "old_directory": "admitted public channels only, mapped to visibility company",
    "old_private": "omitted even when admitted",
    "security": "current server audience applies to stale clients",
    "legacy_mutations": "restricted to 1.1 create/archive/restore; non-create is fenced by a current-generation read under the channel lock and all newer mutations are refused",
    "errors": "new typed reasons map to plain matrix_400/403/404/409 on old wires; #general archive/leave remains default protected on legacy routes"
  },
  "activation": {
    "public": "may activate when current clients safely parse public admission",
    "private": "requires minimum desktop/phone classifier support; otherwise private creation and admission remain inactive",
    "manager": "advance assignment epoch and require exact-plan readback before either activation"
  },
  "dependent_surfaces": [
    "search",
    "file reserve/publish/grant/ingress",
    "thumbnail/preview",
    "push/mentions/counts",
    "catch-up/link unfurl",
    "project readers"
