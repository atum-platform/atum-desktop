  "row": "C2/C3 admission- and participation-scoped Team Space files and previews",
  "providers": [
    "Atum platform file authority and Drive ingress"
  ],
  "consumers": [
    "native Matrix clients",
    "preview worker"
  ],
  "base": {
    "contract": "atum.company-drive-files/1.1",
    "path": "spec/company-drive-files/v1.1",
    "kind": "pack",
    "sha256": "3a456a31c87a6cd8e096cec8ef70f7685a8a975b755e9bf23d26386a6531c128",
    "rule": "additive v2 reference family; v1/v1.1 bytes remain frozen"
  },
  "audience": {
    "union": [
      "channel",
      "conversation"
    ],
    "channel": "active company membership at current epoch AND active channel admission; signed target carries immutable public/private visibility",
    "conversation": "active company membership at recorded epoch AND current participation",
    "non_grants": [
      "admin rank",
      "Matrix membership",
      "room history",
      "copied reference",
      "hidden state",
      "project membership",
      "provider resource"
    ]
  },
  "operations": {
    "reserve": "request/response bind company, exact audience, viewer epoch and audience generation before allocating upload session",
    "publish": "request/response recheck exact audience and immutable file hash before ready",
    "status": "request/response is authority-scoped and exposes no provider resource",
    "download_grant": "short-lived opaque grant id bound to viewer epoch and audience generation; no URL/token projected",
    "preview": "request/response bound to target, viewer epoch, audience generation and transform version"
  },
  "checks": [
    "reserve",
    "upload write",
    "status",
    "publish",
    "download grant",
    "ingress byte read",
    "thumbnail",
    "preview"
  ],
  "preview": {
    "scope": [
      "file revision",
      "company",
      "target kind and UUID",
      "audience generation",
      "viewer admission epoch",
      "transform version"
    ],
    "cache": "fresh audience check before serve; URL alone never keys cache",
    "projection": "no resource id, provider URL, credential or reusable renderer bearer"
  },
  "replay": {
    "scope": "(actor, requestId)",
    "target": "immutable; kind, UUID, visibility or generation change conflicts",
    "provider": "reconcile deterministic identity and stat/hash; never blind second write"
  },
  "compatibility": {
    "legacy": "v1/v1.1 only for admitted legacy public channels",
    "restricted": "private channels and conversations require v2",
    "fallback": "omit unsupported files; never raw mxc"
  },
  "errors": [
    "audience_revoked",
    "target_mismatch",
    "admission_epoch_stale",
    "audience_generation_stale",
    "preview_scope_mismatch",
    "preview_unavailable"
  ],
  "types": {
    "uuid": {
      "type": "string",
      "min": 36,
      "max": 36,
      "pattern": "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
    },
    "generation": {
      "type": "integer",
      "min": 1,
      "max": 9007199254740991
    },
    "epoch": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "min": 1,
      "max": 1
    },
    "size": {
      "type": "integer",
      "min": 0,
      "max": 20971520
    },
    "sha256": {
      "type": "string",
      "min": 64,
      "max": 64,
      "pattern": "[0-9a-f]{64}"
    },
    "name": {
      "type": "string",
      "min": 1,
      "max": 255
    },
    "content_type": {
      "type": "string",
      "min": 3,
      "max": 128,
      "pattern": "[A-Za-z0-9!#$&^_.+-]{1,64}/[A-Za-z0-9!#$&^_.+-]{1,63}"
    },
    "channel_audience": {
      "type": "object",
      "required": {
        "kind": {
          "const": "channel"
        },
        "channel_id": {
          "ref": "uuid"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        }
      }
    },
    "conversation_audience": {
      "type": "object",
      "required": {
        "kind": {
          "const": "conversation"
        },
        "conversation_id": {
          "ref": "uuid"
        }
      }
    },
    "audience": {
      "anyOf": [
        {
          "ref": "channel_audience"
        },
        {
          "ref": "conversation_audience"
        }
      ]
    },
    "file_ref": {
      "type": "object",
      "required": {
        "v": {
          "const": 2
        },
        "company_id": {
          "ref": "uuid"
        },
        "audience": {
