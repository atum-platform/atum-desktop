    "reserve_request":{"type":"object","required":{"requestId":{"ref":"uuid"},"name":{"ref":"file_name"},"contentType":{"ref":"content_type"},"size":{"ref":"byte_size"},"sha256":{"ref":"sha256"}},"optional":{},"additional":false},
    "ingress_grant":{"type":"object","required":{"token":{"ref":"grant_token"},"expiresAtMs":{"ref":"timestamp_ms"}},"optional":{},"additional":false},
    "reserve_response":{"type":"object","required":{"schemaVersion":{"const":1},"state":{"const":"reserved"},"requestId":{"ref":"uuid"},"file":{"ref":"file_ref"},"serverUrl":{"ref":"https_origin"},"uploadGrant":{"ref":"ingress_grant"}},"optional":{},"additional":false},
