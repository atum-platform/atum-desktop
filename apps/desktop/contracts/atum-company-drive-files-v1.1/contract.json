    "file_ref":{"type":"object","required":{"v":{"const":1},"company_id":{"ref":"uuid"},"channel_id":{"ref":"uuid"},"file_id":{"ref":"uuid"},"revision":{"ref":"revision"},"name":{"ref":"file_name"},"content_type":{"ref":"content_type"},"size":{"ref":"byte_size"},"sha256":{"ref":"sha256"}},"optional":{},"additional":false},
    "file_info":{"type":"object","required":{"mimetype":{"ref":"content_type"},"size":{"ref":"byte_size"}},"optional":{},"additional":false},
    "reply_relation":{"type":"object","required":{"event_id":{"ref":"event_id"}},"optional":{},"additional":false},
    "thread_relation":{"type":"object","required":{"rel_type":{"const":"m.thread"},"event_id":{"ref":"event_id"},"is_falling_back":{"const":true},"m.in_reply_to":{"ref":"reply_relation"}},"optional":{},"additional":false},
