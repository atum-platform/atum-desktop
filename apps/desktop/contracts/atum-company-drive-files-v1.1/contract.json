    "publish_request":{"type":"object","required":{"requestId":{"ref":"uuid"},"fileId":{"ref":"uuid"},"revision":{"ref":"revision"},"roomId":{"ref":"room_id"},"eventId":{"ref":"event_id"},"matrixTransactionId":{"ref":"matrix_transaction_id"}},"optional":{},"additional":false},
    "publish_response":{"type":"object","required":{"schemaVersion":{"const":1},"state":{"const":"published"},"file":{"ref":"file_ref"},"roomId":{"ref":"room_id"},"eventId":{"ref":"event_id"},"matrixTransactionId":{"ref":"matrix_transaction_id"}},"optional":{},"additional":false},
    "download_grant_response":{"type":"object","required":{"schemaVersion":{"const":1},"state":{"const":"ready"},"file":{"ref":"file_ref"},"serverUrl":{"ref":"https_origin"},"downloadGrant":{"ref":"ingress_grant"}},"optional":{},"additional":false},
    "error_response":{"type":"object","required":{"schemaVersion":{"const":1},"status":{"anyOf":[{"const":400},{"const":403},{"const":404},{"const":409},{"const":429},{"const":503}]},"headers":{"type":"object","required":{"cacheControl":{"const":"no-store"}},"optional":{"retryAfterSeconds":{"type":"integer","min":1,"max":86400}},"additional":false},"body":{"type":"object","required":{"errcode":{"enum":["matrix_invalid","matrix_denied","matrix_not_found","matrix_conflict","matrix_limit","matrix_unavailable"]},"reason":{"enum":["invalid","denied","revoked","not_found","space_preparing","upload_incomplete","upload_unknown","version_conflict","limit","provider_unavailable"]}},"optional":{},"additional":false}},"optional":{},"additional":false}
