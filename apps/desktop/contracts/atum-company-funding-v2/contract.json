  "row": "Company AI Release B company wallet, PayOS top-up and one-hold paid execution",
  "providers": ["Atum company funding and cloud admission authority"],
  "consumers": ["Atum model gateway", "Atum cloud controller", "Atum desktop native bridge", "Atum Team Space UI"],
  "routes": [
    "GET /api/matrix/v1/companies/{companyId}/wallet",
    "GET /api/matrix/v1/companies/{companyId}/wallet/packs",
    "POST /api/matrix/v1/companies/{companyId}/wallet/orders",
    "GET /api/matrix/v1/companies/{companyId}/wallet/orders/{orderId}",
    "RPC company_funding_reserve_v2(task,model_ceiling,compute_seconds)",
    "RPC company_funding_check_v2(reservation)",
    "RPC company_funding_settle_v2(reservation,receipts,compute_seconds,key)"
