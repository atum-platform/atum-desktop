  "invariants": [
    {"id":"wallet-available-equation","message":"wallet.response","op":"sum_eq","left":["balances.available","balances.held"],"right":["balances.paid","balances.earned","balances.promo"],"required":true},
    {"id":"company-channel-holds-model-only","message":"reservation.response","when":{"path":"scopeKind","equals":"company_channel"},"op":"same","left":"ceilingMicroProtons","right":"modelCeilingMicroProtons","required":true},
    {"id":"reservation-charge-within-ceiling","message":"reservation.response","when":{"path":"state","equals":"closed"},"op":"le","left":"chargedMicroProtons","right":["ceilingMicroProtons"],"required":true},
    {"id":"settlement-reservation-id","message":"settlement.accounting","op":"same","left":"settlement.reservationId","right":"reservation.reservationId","required":true},
    {"id":"settlement-closed-charge","message":"settlement.accounting","op":"same","left":"settlement.chargedMicroProtons","right":"reservation.chargedMicroProtons","required":true},
    {"id":"settlement-charge-within-ceiling","message":"settlement.accounting","op":"le","left":"settlement.chargedMicroProtons","right":["reservation.ceilingMicroProtons"],"required":true},
    {"id":"settlement-closes-held-ceiling","message":"settlement.accounting","op":"sum_eq","left":["settlement.chargedMicroProtons","settlement.releasedMicroProtons"],"right":["reservation.ceilingMicroProtons"],"required":true},
    {"id":"gateway-model-fits-hold","message":"gateway-grant.response","op":"le","left":"maxTurnMicroProtons","right":["ceilingMicroProtons"],"required":true},
    {"id":"company-owner-payer-match","message":"gateway-grant.response","op":"same","left":"owner.companyId","right":"payer.companyId","required":true},
    {"id":"company-owner-scope-match","message":"gateway-grant.response","op":"same","left":"owner.companyId","right":"scope.companyId","required":true}
