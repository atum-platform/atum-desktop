    "order_create_and_read": "active_owner_only",
    "ordinary_member": "403_and_use_company_ai_view_enabled_state"
  },
  "acceptance_requirements": [
    "same_task_and_same_reserve_intent_is_exact_replay",
    "same_task_with_changed_ceiling_or_compute_bound_conflicts",
    "check_revalidates_authority_and_covers_reserved_revoked_closed_and_budget_exhausted",
    "company_channel_hold_equals_existing_model_cost_ceiling_and_compute_seconds_are_unpriced"
  ],
