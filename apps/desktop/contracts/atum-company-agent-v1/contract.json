      }
    },
    {
      "id": "rotate-companyId",
      "message": "home.transition",
      "op": "same",
      "left": "before.companyId",
      "right": "after.companyId",
      "required": true,
      "when": {
        "path": "reason",
        "equals": "disclosure_change"
      }
    },
    {
      "id": "rotate-agentPrincipal",
      "message": "home.transition",
      "op": "same",
      "left": "before.agentPrincipal",
      "right": "after.agentPrincipal",
      "required": true,
      "when": {
        "path": "reason",
        "equals": "disclosure_change"
      }
    },
    {
      "id": "rotate-new-homeId",
      "message": "home.transition",
      "op": "not_same",
      "left": "before.homeId",
      "right": "after.homeId",
      "required": true,
      "when": {
        "path": "reason",
        "equals": "disclosure_change"
      }
    },
    {
      "id": "rotate-new-audiencePartitionId",
      "message": "home.transition",
      "op": "not_same",
      "left": "before.audiencePartitionId",
      "right": "after.audiencePartitionId",
      "required": true,
      "when": {
        "path": "reason",
        "equals": "disclosure_change"
      }
    },
    {
      "id": "rotate-epoch",
      "message": "home.transition",
      "op": "eq",
      "left": "after.disclosureEpoch",
      "right": [
        "before.disclosureEpoch"
      ],
      "required": true,
      "offset": 1,
      "when": {
        "path": "reason",
        "equals": "disclosure_change"
      }
    },
