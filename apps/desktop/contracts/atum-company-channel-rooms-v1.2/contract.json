  "types": {
    "uuid": {
      "type": "string",
      "min": 36,
      "max": 36,
      "pattern": "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
    },
    "digest": {
      "type": "string",
      "min": 64,
      "max": 64,
      "pattern": "[0-9a-f]{64}"
    },
    "generation": {
      "type": "integer",
      "min": 1,
      "max": 9007199254740991
    },
    "member_ref": {
      "type": "string",
      "min": 43,
      "max": 43,
      "pattern": "[A-Za-z0-9_-]{43}"
    },
    "principal": {
      "ref": "uuid"
    },
    "user_id": {
      "type": "string",
      "min": 4,
      "max": 512,
      "pattern": "@[!-9;-~]{1,255}:[!-~]{1,255}"
    },
    "channel_target": {
      "type": "object",
      "required": {
        "kind": {
          "const": "channel"
        },
        "channelId": {
          "ref": "uuid"
        }
      }
    },
    "conversation_target": {
      "type": "object",
      "required": {
        "kind": {
          "const": "conversation"
        },
        "conversationId": {
          "ref": "uuid"
        },
        "conversationKind": {
          "enum": [
            "dm",
            "group_dm"
          ]
        },
        "participantSetDigest": {
          "ref": "digest"
        }
      }
    },
    "target": {
      "anyOf": [
        {
          "ref": "channel_target"
        },
        {
          "ref": "conversation_target"
        }
      ]
    },
    "recipient": {
      "type": "object",
      "required": {
        "memberRef": {
          "ref": "member_ref"
        },
        "admissionEpoch": {
          "ref": "generation"
        },
        "admissionGeneration": {
          "ref": "generation"
        },
        "principal": {
          "ref": "principal"
        },
        "userId": {
          "ref": "user_id"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "required": {
        "memberRef": {
          "ref": "member_ref"
        },
        "admissionEpoch": {
          "ref": "generation"
        },
        "reason": {
          "enum": [
            "left",
            "removed",
            "company_removed",
            "epoch_changed"
          ]
        }
      },
      "optional": {
        "principal": {
          "ref": "principal"
        },
        "userId": {
          "ref": "user_id"
        }
      }
    },
    "unresolved": {
      "type": "object",
      "required": {
        "memberRef": {
          "ref": "member_ref"
        },
        "admissionEpoch": {
          "ref": "generation"
        },
        "reason": {
          "enum": [
            "missing_matrix_mapping",
            "invitation_uncertain"
          ]
        }
      }
    },
    "possible_grant": {
      "type": "object",
      "required": {
        "memberRef": {
          "ref": "member_ref"
        },
        "admissionEpoch": {
          "ref": "generation"
        },
        "source": {
          "enum": [
            "acknowledged",
            "issued",
            "uncertain"
          ]
        },
        "userId": {
          "ref": "user_id"
        }
      },
      "optional": {
        "principal": {
          "ref": "principal"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": {
        "displayName": {
          "type": "string",
          "min": 1,
          "max": 80
        },
        "topic": {
          "type": "string",
          "min": 0,
          "max": 250
        },
        "posting": {
          "enum": [
            "enabled",
            "archived_read_only",
            "participant_read_only"
          ]
        },
        "metadataRevision": {
          "ref": "generation"
        }
      }
    },
    "plan_request": {
      "type": "object",
      "required": {
