  "row": "C3 channel-or-conversation hosted-manager targets",
  "providers": [
    "Atum platform room authority"
  ],
  "consumers": [
    "fenced hosted Matrix room manager"
  ],
  "base": {
    "contract": "atum.company-channel-rooms/1.1",
    "path": "spec/company-channel-rooms/v1.1",
    "kind": "pack",
    "sha256": "17a0db834226d0a61a5d470b2adb036562f0597476af7af818b20663a1b858c0",
    "rule": "additive target union; 1.1 remains frozen"
  },
  "target": {
    "union": [
      "channel",
      "conversation"
    ],
    "conversation_identity": "company, conversation UUID, kind and participant-set digest",
    "fake_channel": "forbidden"
  },
  "plan": {
    "inheritance": "all 1.1 exact recipient, exclusion, unresolved admission, possible-grant, action, metadata and witness semantics apply inside either target variant",
    "identityless": "an exclusion without historical Matrix userId is skipped; it never blocks mapped exclusions and never fabricates an identity"
  },
  "audience": {
    "conversation": "exact current participants at recorded membership admission epochs",
    "admin": "rank adds no recipient",
    "possible_grants": "acknowledged, issued and uncertain invitation identities remain until witnessed banned"
  },
  "removal": {
    "continue": "at least two effective participants",
    "read_only": "fewer than two",
    "witness": "all possible grants"
  },
  "activation": {
    "assignment_epoch": "advance and retire old manager session",
    "rollback": "retain target, binding and exclusions; never cast as channel or Personal"
  },
  "errors": [
    "unsupported_target_kind",
    "participant_digest_mismatch"
  ],
