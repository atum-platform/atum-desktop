        "exclusions": {
          "type": "array",
          "items": {
            "ref": "exclusion"
          },
          "min": 0,
          "max": 100,
          "unique": true
        },
        "unresolvedAdmissions": {
          "type": "array",
          "items": {
            "ref": "unresolved"
          },
          "min": 0,
          "max": 100,
          "unique": true
        },
        "possibleGrants": {
          "type": "array",
          "items": {
            "ref": "possible_grant"
          },
          "min": 0,
          "max": 200,
          "unique": true
        },
        "action": {
          "enum": [
            "reconcile",
            "archive",
            "restore"
          ]
        },
        "metadata": {
          "ref": "metadata"
        }
      }
    },
    "reconcile_request": {
      "type": "object",
      "required": {
        "schemaVersion": {
          "const": 3
        },
        "companyId": {
          "ref": "uuid"
        },
        "target": {
          "ref": "target"
        },
        "planGeneration": {
          "ref": "generation"
        },
        "invitedMemberRefs": {
          "type": "array",
          "items": {
            "ref": "member_ref"
          },
          "min": 0,
          "max": 100,
          "unique": true
        },
        "bannedMemberRefs": {
          "type": "array",
          "items": {
            "ref": "member_ref"
          },
          "min": 0,
          "max": 100,
          "unique": true
        },
        "witnessedPossibleGrantUserIds": {
          "type": "array",
          "items": {
            "ref": "user_id"
          },
          "min": 0,
          "max": 200,
          "unique": true
        },
        "metadataRevision": {
          "ref": "generation"
        },
        "policyWitness": {
          "ref": "digest"
        }
      }
    },
    "reconcile_response": {
      "type": "object",
      "required": {
        "schemaVersion": {
          "const": 3
        },
        "companyId": {
          "ref": "uuid"
        },
        "target": {
          "ref": "target"
        },
        "planGeneration": {
          "ref": "generation"
        },
        "state": {
          "enum": [
            "pending",
            "complete"
          ]
        },
        "remainingUnresolved": {
          "type": "integer",
          "min": 0,
          "max": 100
        }
      }
    },
    "error_plain": {
      "type": "object",
      "required": {
        "error": {
          "enum": [
            "matrix_400",
            "matrix_403",
            "matrix_404",
            "matrix_409",
            "matrix_429",
            "matrix_503"
          ]
        }
      }
    },
    "error_typed": {
      "type": "object",
      "required": {
        "error": {
          "enum": [
            "matrix_409",
            "matrix_503"
          ]
        },
        "details": {
          "type": "object",
          "required": {
            "reason": {
              "enum": [
                "stale_plan",
                "target_mismatch",
                "plan_too_large",
                "mapping_unresolved",
                "witness_incomplete",
                "unsupported_target_kind",
                "participant_digest_mismatch"
              ]
            }
          }
        }
      }
    },
    "error_response": {
      "anyOf": [
        {
          "ref": "error_plain"
        },
        {
          "ref": "error_typed"
        }
      ]
    }
