      "pattern": "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
    },
    "digest": {
      "type": "string",
      "min": 64,
      "max": 64,
      "pattern": "[0-9a-f]{64}"
