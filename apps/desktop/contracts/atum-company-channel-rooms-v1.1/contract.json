  "base": {
    "contract": "atum.company-channel-rooms/1",
    "path": "spec/company-channel-rooms/v1",
    "kind": "pack",
    "sha256": "45f785f4db22f330f9d58c88e5af06a655581528f73fa947382e82b37e9fc60e",
    "rule": "successor; v1 remains frozen"
  },
  "plan": {
    "sets": "desiredRecipients, exclusions, unresolvedAdmissions and possibleGrants are complete exact sets",
    "generations": [
      "companyGeneration",
      "channelGeneration",
      "planGeneration"
    ],
    "exclusions": "processed even when another desired admission is unresolved; identity-less principals with no historical Matrix userId are skipped rather than blocking mapped exclusions",
    "uncertain": "issued or uncertain invitations are possible grants until witnessed banned"
  },
  "completion": {
    "rule": "current readback plus exact invited, banned, possible-grant witness, metadata and policy sets",
    "restart": "resume durable effects; never fabricate completion",
    "retention": "retain at most 100 exclusions; after full ban witness and no possible grant remains, prune oldest fully witnessed exclusions before admitting more work"
  },
  "readmission": {
    "general": "for epoch N exclusion and epoch N+1 recipient, witness unban of the old Matrix identity before inviting the new epoch"
  },
  "r1_compatibility": [
    "pending and uncertain invitations count as possible live grants",
    "unmapped admission does not block exclusions",
    "multi-room company removal completes only on the final room witness",
    "SQL authority ends before witnessed Matrix cleanup"
  ],
  "errors": [
    "stale_plan",
    "target_mismatch",
    "plan_too_large",
    "mapping_unresolved",
    "witness_incomplete"
  ],
