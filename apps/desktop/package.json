{
  "name": "hermes",
  "productName": "Atum",
  "private": true,
  "version": "0.20.44",
  "description": "Atum \u2014 AI Superapp cho ng\u01b0\u1eddi Vi\u1ec7t.",
  "author": "Anka Ventures Vietnam Company Limited",
  "type": "module",
  "main": "dist/electron-main.mjs",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "matrix:repair-agent-home": "tsx scripts/repair-matrix-agent-home.ts",
    "matrix:release:mac": "node scripts/release-matrix-mac.mjs",
    "reporting:sourcemaps:matrix": "node scripts/upload-reporting-sourcemaps.mjs --matrix",
    "matrix:pack": "npm run matrix:build && electron-builder --config matrix-builder.json --dir",
    "local-brain:prepare": "node scripts/stage-local-brain.mjs --prepare",
    "local-brain:stage": "node scripts/stage-local-brain.mjs",
    "clean": "npm run clean:e2e && npm run clean:renderer && npm run clean:electron",
    "clean:e2e": "tsc --build tsconfig.e2e.json --clean",
    "clean:renderer": "tsc --build tsconfig.json --clean ",
    "clean:electron": "tsc --build tsconfig.electron.json --clean",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:fake-boot": "cross-env HERMES_DESKTOP_BOOT_FAKE=1 HERMES_DESKTOP_BOOT_FAKE_STEP_MS=650 npm run dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:renderer": "node scripts/assert-root-install.mjs && npm run clean:renderer && vite --host 127.0.0.1 --port 5174",
    "dev:electron": "tsc --build tsconfig.electron.json && wait-on http://127.0.0.1:5174 && node scripts/bundle-electron-main.mjs --dev && cross-env XCURSOR_SIZE=24 HERMES_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron .",
    "profile:main": "tsc --build tsconfig.electron.json && wait-on http://127.0.0.1:5174 && node scripts/bundle-electron-main.mjs --dev && cross-env XCURSOR_SIZE=24 HERMES_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron --inspect=9229 .",
    "profile:main:cpu": "tsc --build tsconfig.electron.json && wait-on http://127.0.0.1:5174 && node scripts/bundle-electron-main.mjs --dev && cross-env XCURSOR_SIZE=24 NODE_OPTIONS=--cpu-prof HERMES_DESKTOP_DEV_SERVER=http://127.0.0.1:5174 electron .",
    "start": "npm run build && electron .",
    "prebuild": "npm run clean",
    "build": "node scripts/assert-root-install.mjs && node scripts/write-build-stamp.mjs && vite build && node scripts/bundle-electron-main.mjs && node scripts/stage-native-deps.mjs",
    "postbuild": "node scripts/assert-dist-built.mjs",
    "runtime:stage": "node scripts/stage-bundled-runtime.mjs build/runtime-test",
    "verify:bundled-app": "node scripts/verify-packaged-bundled-runtime.mjs",
    "verify:bundled-browser": "node scripts/verify-packaged-bundled-browser.mjs",
    "verify:cloud-data-v1": "node contracts/atum-cloud-data-v1/validate.mjs && python3 contracts/atum-cloud-data-v1/validate.py",
    "prebuilder": "node scripts/patch-electron-builder-mac-binary.mjs",
    "builder": "cross-env NODE_OPTIONS=--max-old-space-size=16384 node scripts/run-electron-builder.mjs",
    "pack": "npm run build && npm run builder -- --dir",
    "pack:prod": "node scripts/pack-prod.mjs",
    "install:local:mac": "node scripts/install-local-mac.mjs",
    "dist": "npm run build && npm run builder",
    "dist:mac": "npm run build && npm run builder -- --mac",
    "dist:mac:dmg": "npm run build && npm run builder -- --mac dmg",
    "dist:mac:zip": "npm run build && npm run builder -- --mac zip",
    "dist:win": "npm run build && npm run builder -- --win",
    "dist:win:msi": "npm run build && npm run builder -- --win msi",
    "dist:win:nsis": "npm run build && npm run builder -- --win nsis",
    "dist:linux": "npm run build && npm run builder -- --linux AppImage deb rpm",
    "perf": "node scripts/perf/run.mjs",
    "perf:serve": "node scripts/perf/serve.mjs",
    "shots:shell": "node scripts/shell-shots.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:desktop:all": "node scripts/test-desktop.mjs all",
    "test:desktop:dmg": "node scripts/test-desktop.mjs dmg",
    "test:desktop:nsis": "node scripts/test-desktop.mjs nsis",
    "test:desktop:existing": "node scripts/test-desktop.mjs existing",
    "test:desktop:fresh": "node scripts/test-desktop.mjs fresh",
    "typecheck": "npm run check:boundary && tsc -p . --noEmit && tsc -p tsconfig.consumer-browser.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint src/ electron/ 'scripts/**/*.ts'",
    "lint:fix": "eslint src/ electron/ 'scripts/**/*.ts' --fix",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' 'electron/**/*.ts' 'vite.config.ts'",
    "fix": "npm run lint:fix && npm run fmt",
    "test:ui": "npm run test:ui:parallel && npm run test:ui:device-approval",
    "test:ui:parallel": "vitest run --project ui --exclude src/matrix/device-approval.integration.test.ts",
    "test:ui:device-approval": "vitest run --project ui src/matrix/device-approval.integration.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:desktop:platforms": "vitest run --project electron",
    "test": "vitest run && node --test scripts/atum-branding.test.mjs",
    "preview": "node scripts/assert-root-install.mjs && vite preview --host 127.0.0.1 --port 4174",
    "check:test:desktop:platforms": "vitest run --project electron --maxWorkers=2",
    "check:test:ui": "npm run test:ui",
    "check:test:desktop:all": "npm run test:desktop:all",
    "check:lint": "npm run typecheck && npm run lint",
    "check": "npm run verify:cloud-data-v1 && npm run check:lint && npm run check:test:ui && npm run test:desktop:platforms && npm run test:desktop:all",
    "build:e2e": "npm run build && node scripts/bundle-electron-main.mjs --dev",
    "test:e2e": "npm run build:e2e && playwright test e2e/",
    "test:e2e:visual": "npm run build:e2e && WLR_BACKENDS=headless WLR_NO_HARDWARE_CURSORS=1 cage -- npx playwright test e2e/ --reporter=list",
    "test:e2e:update-snapshots": "npm run build:e2e && WLR_BACKENDS=headless WLR_NO_HARDWARE_CURSORS=1 cage -- npx playwright test e2e/ --reporter=list --update-snapshots",
    "reporting:sourcemaps": "node scripts/upload-reporting-sourcemaps.mjs",
    "reporting:smoke:matrix": "node scripts/smoke-matrix-services.mjs",
    "check:test:upstream-watch": "node --test ../../scripts/upstream-watch/core.test.mjs",
    "reporting:smoke": "node scripts/smoke-reporting.mjs",
    "release:mac": "node scripts/release-mac.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "matrix:candidate:publish": "node scripts/publish-matrix-candidate.mjs",
    "runtime:audit-licenses": "node scripts/audit-runtime-licenses.mjs",
    "matrix:audit:ship": "node scripts/audit-matrix-ship-artifact.mjs",
    "check:boundary": "node scripts/check-client-boundary.mjs"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.23",
    "@assistant-ui/react-streamdown": "^0.3.4",
    "@atum/kit": "file:../../packages/atum-kit",
    "@audiowave/react": "^0.6.2",
    "@chenglou/pretext": "^0.0.6",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hermes/shared": "file:../shared",
    "@icons-pack/react-simple-icons": "=13.11.1",
    "@lezer/highlight": "^1.2.3",
    "@nanostores/react": "^1.1.0",
    "@nous-research/ui": "^0.13.0",
    "@radix-ui/react-focus-scope": "1.1.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/core": "10.73.0",
    "@sentry/node-core": "10.73.0",
    "@streamdown/code": "^1.1.1",
    "@supabase/auth-js": "2.112.4",
    "@supabase/realtime-js": "=2.15.1",
    "@tabler/icons-react": "^3.41.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/qrcode": "^1.5.6",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "dnd-core": "^14.0.1",
    "dompurify": "^3.4.11",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-text": "^4.0.2",
    "hpke-js": "1.8.0",
    "ignore": "^7.0.5",
    "js-yaml": "4.3.2",
    "katex": "^0.18.2",
    "leva": "^0.10.1",
    "mdast-util-to-hast": "13.2.1",
    "mermaid": "^11.15.0",
    "motion": "^12.38.0",
    "nanostores": "^1.3.0",
    "node-pty": "1.1.0",
    "posthog-node": "5.51.6",
    "prosemirror-commands": "1.7.2",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-arborist": "^3.5.0",
    "react-dnd-html5-backend": "^14.0.3",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.17.0",
    "react-shiki": "^0.9.3",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remend": "^1.3.0",
    "shiki": "^4.0.2",
    "simple-git": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tldts": "7.4.19",
    "tw-shimmer": "^0.4.11",
    "unicode-animations": "^1.0.3",
    "unified": "^11.0.5",
    "unist-util-visit-parents": "^6.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vfile": "^6.0.3",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.6",
    "@anthropic-ai/sandbox-runtime": "0.0.78"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.3"
  },
  "devDependencies": {
    "matrix-js-sdk": "42.4.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.8.0",
    "openid-client": "6.8.8",
    "fake-indexeddb": "6.2.5",
    "@aws-sdk/client-s3": "3.1127.0",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "^4.0.6",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "=1.58.2",
    "@sentry/cli": "3.7.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "44.10.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rcedit": "^5.0.2",
    "semver": "7.7.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  },
  "build": {
    "electronVersion": "44.10.1",
    "appId": "com.atum.desktop",
    "productName": "Atum",
    "executableName": "Atum",
    "protocols": [
      {
        "name": "Atum Protocol",
        "schemes": [
          "hermes"
        ]
      },
      {
        "name": "Atum Protocol",
        "schemes": [
          "atum"
        ]
      }
    ],
    "artifactName": "Atum-${version}-${os}-${arch}.${ext}",
    "icon": "assets/icon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/**/*.map",
      "assets/**",
      "public/**",
      "package.json"
    ],
    "beforeBuild": "scripts/before-build.mjs",
    "beforePack": "scripts/before-pack.mjs",
    "afterPack": "scripts/after-pack.mjs",
    "extraResources": [
      {
        "from": "build/install-stamp.json",
        "to": "install-stamp.json"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "afterSign": "scripts/notarize.mjs",
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**",
      "dist/**",
      "assets/pets/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.inherit.plist",
      "icon": "assets/icon-mac.icns",
      "extendInfo": {
        "CFBundleDisplayName": "Atum",
        "CFBundleExecutable": "Atum",
        "CFBundleName": "Atum",
        "NSCalendarsUsageDescription": "Atum reads selected calendars and creates or edits personal events after you confirm each change.",
        "NSCalendarsFullAccessUsageDescription": "Atum reads selected calendars and creates or edits personal events after you confirm each change.",
        "NSAppleEventsUsageDescription": "Atum opens your chosen Word document beside chat, reads its current text, and applies text edits you request.",
        "NSAudioCaptureUsageDescription": "Atum c\u1ea7n truy c\u1eadp \u00e2m thanh cho c\u00e1c cu\u1ed9c tr\u00f2 chuy\u1ec7n b\u1eb1ng gi\u1ecdng n\u00f3i.",
        "NSMicrophoneUsageDescription": "Atum c\u1ea7n d\u00f9ng micr\u00f4 \u0111\u1ec3 b\u1ea1n c\u00f3 th\u1ec3 tr\u00f2 chuy\u1ec7n b\u1eb1ng gi\u1ecdng n\u00f3i."
      },
      "gatekeeperAssess": false,
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "C\u00e0i \u0111\u1eb7t Atum",
      "backgroundColor": "#f5f5f7",
      "iconSize": 96,
      "window": {
        "width": 560,
        "height": 360
      },
      "contents": [
        {
          "x": 160,
          "y": 170,
          "type": "file"
        },
        {
          "x": 400,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "legalTrademarks": "Atum",
      "target": [
        "nsis",
        "msi"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "category": "Development",
      "maintainer": "Nous Research <support@nousresearch.com>",
      "synopsis": "Atum \u2014 AI Superapp cho ng\u01b0\u1eddi Vi\u1ec7t.",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Atum",
      "uninstallDisplayName": "Atum",
      "warningsAsErrors": false
    }
  }
}
