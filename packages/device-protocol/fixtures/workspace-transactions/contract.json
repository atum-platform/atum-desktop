  "row": "S1 C0 (one agent everywhere)",
  "providers": [
    "DA SQL and the Drive broker (WS-5p): cloud_workspace_grants, cloud_workspace_tasks, the ws_* operations"
  ],
  "consumers": [
    "CX controller (WS-5a): WorkspaceSession",
    "Desktop device (WS-5a): WorkspaceCopies"
  ],
  "routes": {
    "owner": {
      "native_base": "/api/matrix/v1",
      "operations": {
        "POST /cloud/workspaces": [
          "grant.request",
          "grant.response"
        ]
      }
    },
    "controller": {
      "base": "/api/matrix/v1/cloud/controller",
      "operations": {
        "POST /executors/{executorId}/files": [
          "ws_manifest",
          "ws_read",
          "ws_stage",
          "ws_commit",
          "ws_place"
        ]
      }
    }
  },
  "s1_rule": "Every hydrated input is a read dependency. If any input changed, outputs are placed as siblings, never overwrites. There is never a retry; unknown is terminal. Deletions and renames are proposed and reported, not applied.",
  "sibling_naming": "\"<name> (T <yyyy-mm-dd> <task8>)<.ext>\", written if_not_exist",
  "exclusions": "The engine's setAtumRootExclusions list (csync_exclude.cpp): .hermes/, .env*, keys and databases never hydrate and can never be written.",
  "parameters": {
    "manifest_max_entries": 5000,
    "manifest_max_depth": 16,
    "outputs_max": 16,
    "output_max_bytes": 33554432,
    "total_max_bytes": 67108864,
    "put_timeout_ms": 120000,
    "hydrate_max_bytes": 67108864,
    "hydrate_max_files": 2000
  },
  "migrations": {
    "reserved": {
      "0178": "WS-5p: cloud_workspace_grants, cloud_workspace_tasks, the ws_* SQL operations gated by the live lease"
    }
  },
  "types": {
    "uuid": {
      "type": "string",
      "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    },
    "timestamp_ms": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "sha256_hex": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "b64u_sha256": {
      "type": "string",
      "pattern": "[A-Za-z0-9_-]{43}"
    },
    "room_id": {
      "type": "string",
      "min": 2,
      "max": 1024,
      "pattern": "![!-~]+"
    },
    "event_id": {
      "type": "string",
      "min": 2,
      "max": 1024,
      "pattern": "[$][!-~]+"
    },
    "user_id": {
      "type": "string",
      "min": 4,
      "max": 1024,
      "pattern": "@[!-9;-~]+:[!-~]+"
    },
    "device_id": {
      "type": "string",
      "min": 1,
      "max": 255,
      "pattern": "[!-~]+"
    },
    "json_value": {
      "anyOf": [
        {
          "type": "object",
          "additional": true
        },
        {
          "type": "array",
          "items": {
            "ref": "json_value"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "etag": {
      "type": "string",
      "min": 1,
      "max": 512,
      "pattern": "[!-~]+"
    },
    "ws_path": {
      "type": "string",
      "min": 1,
      "max": 1024,
      "pattern": "[^\\u0000]+"
    },
    "resource": {
      "type": "object",
      "required": {
        "storage": {
          "type": "string",
          "min": 1,
          "max": 255,
          "pattern": "[!-~]+"
        },
        "space": {
          "type": "string",
          "min": 1,
          "max": 255,
          "pattern": "[!-~]+"
        },
        "opaque": {
          "type": "string",
          "min": 1,
          "max": 255,
          "pattern": "[!-~]+"
        }
      }
    },
    "local_state": {
      "enum": [
        "clean",
        "dirty",
        "new",
        "absent"
      ]
    },
    "device_revision": {
      "type": "object",
      "required": {
        "inode": {
          "type": "integer",
          "min": 0,
          "max": 9007199254740991
        },
        "mtimeNs": {
          "type": "string",
          "min": 1,
          "max": 24,
          "pattern": "[0-9]+"
        },
        "size": {
          "type": "integer",
          "min": 0,
          "max": 9007199254740991
        }
      }
    },
    "manifest_entry": {
      "type": "object",
      "required": {
        "path": {
          "ref": "ws_path"
        },
        "etag": {
          "ref": "etag"
        },
        "size": {
          "type": "integer",
          "min": 0,
          "max": 33554432
        },
