            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "directions": {
    "owner_to_platform": {
      "description": "The owner's native client to DA. The owner is the introspected principal.",
      "forbidden_fields": [
        "owner",
        "ownerPrincipal",
        "principal",
        "payer",
        "accessToken",
        "credential",
        "token",
        "leaseToken"
      ]
    },
    "platform_to_owner": {
      "description": "DA to the owner's client.",
      "forbidden_fields": [
        "accessToken",
        "credential",
        "token",
        "leaseToken"
      ]
    },
    "controller_to_platform": {
      "description": "The controller to DA with its credential; DA derives owner and agent from the executor.",
      "forbidden_fields": [
        "owner",
        "ownerPrincipal",
        "principal",
        "agentPrincipal",
        "payer",
        "accessToken",
        "credential",
        "token"
      ]
    },
    "platform_to_controller": {
      "description": "DA and the Drive broker to the controller.",
      "forbidden_fields": [
        "credential",
        "recoveryKey",
        "machineAuthKey"
      ]
    },
    "platform_to_client": {
      "description": "DA's error envelope.",
      "forbidden_fields": [
        "accessToken",
        "credential",
        "token",
        "leaseToken"
      ]
    },
    "controller_store": {
      "description": "The transaction manifest the controller keeps and also writes under <ws>/.atum/tasks/.",
      "forbidden_fields": [
        "leaseToken",
        "credential",
        "accessToken",
        "machineAuthKey"
      ]
    },
    "conformance": {
      "description": "Typed placement vectors; not wire payloads.",
      "forbidden_fields": []
    }
  },
