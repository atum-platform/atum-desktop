          "enum": [
            "file",
            "container"
          ]
        }
      }
    },
    "input": {
      "type": "object",
      "required": {
        "resource": {
          "ref": "resource"
        },
        "path": {
          "ref": "ws_path"
        },
        "etag": {
          "ref": "etag"
        },
        "size": {
          "type": "integer",
          "min": 0,
          "max": 33554432
        },
        "sha256": {
          "ref": "sha256_hex"
        },
        "source": {
          "type": "string",
          "min": 1,
          "max": 300,
          "pattern": "cloud|device:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
        },
        "localState": {
          "ref": "local_state"
        }
      },
      "optional": {
        "deviceRevision": {
          "ref": "device_revision"
        }
      }
    },
    "output": {
      "type": "object",
      "required": {
        "path": {
          "ref": "ws_path"
        },
        "mode": {
          "enum": [
            "create",
            "replace"
          ]
        },
        "baseEtag": {
          "anyOf": [
            {
              "ref": "etag"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact": {
          "type": "object",
          "required": {
            "sha256": {
              "ref": "sha256_hex"
            },
            "size": {
              "type": "integer",
              "min": 0,
              "max": 33554432
            },
            "staged": {
              "type": "object",
              "required": {
                "artifactId": {
