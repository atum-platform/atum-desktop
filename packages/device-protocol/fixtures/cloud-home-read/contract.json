          "min": 0,
          "max": 9007199254740991
        },
        "pathUtf8Bytes": {
          "type": "integer",
          "min": 0,
          "max": 9007199254740991
        },
        "fileBytes": {
          "type": "integer",
          "min": 0,
          "max": 9007199254740991
        },
        "totalBytes": {
          "type": "integer",
          "min": 0,
          "max": 9007199254740991
        },
        "expected": {
          "enum": [
            "allow",
            "home_too_large"
          ]
        }
      }
    },
    "path_mapping_case": {
      "type": "object",
      "required": {
        "caseId": {
          "type": "string",
          "min": 1,
          "max": 80,
          "pattern": "[a-z][a-z0-9_-]*"
