{
  "contract_id": "atum.cloud-home-read",
  "version": 1,
  "status": "frozen",
  "row": "LA Contract 6: bounded owner-authorized committed cloud-home reads",
  "routes": {
    "GET /api/matrix/v1/agents/{agentPrincipal}/cloud-home": {
      "status": "planned",
      "auth": "owner_mas_plus_live_cloud_enrollment_plus_current_owner_mac_v2_lease",
      "cache_control": "no-store",
      "request": "cloud-home.manifest.request",
      "response": "cloud-home.manifest.response",
      "absent": "HTTP 204 with empty body or HTTP 200 with JSON null"
    },
    "POST /api/matrix/v1/agents/{agentPrincipal}/cloud-home/file": {
      "status": "planned",
      "auth": "owner_mas_plus_live_cloud_enrollment_plus_current_owner_mac_v2_lease",
      "cache_control": "no-store",
      "request": "cloud-home.file.request",
      "response": "cloud-home.file.response"
    }
  },
  "parameters": {
    "maximum_files": 4000,
    "maximum_path_utf8_bytes": 512,
    "maximum_file_bytes": 8388608,
    "maximum_total_bytes": 67108864,
    "maximum_base64_characters": 11184812
  },
  "types": {
    "uuid": {
      "type": "string",
      "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    },
    "positive_integer": {
      "type": "integer",
      "min": 1,
      "max": 9007199254740991
    },
    "millis": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "cloud_home_path": {
      "type": "string",
      "min": 1,
      "max": 512
    },
    "standard_base64": {
      "type": "string",
      "max": 11184812,
      "pattern": "(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?"
    },
    "empty_query": {
      "type": "object",
      "required": {}
    },
    "manifest_request": {
      "type": "object",
      "required": {
        "method": {
          "const": "GET"
        },
        "query": {
          "ref": "empty_query"
        },
        "body": {
          "type": "null"
        }
      }
    },
    "file_entry": {
      "type": "object",
      "required": {
        "path": {
          "ref": "cloud_home_path"
        },
        "size": {
          "type": "integer",
          "min": 0,
          "max": 8388608
        },
        "sha256": {
          "ref": "sha256"
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": {
        "profile": {
          "const": "atum.cloud-home-read/1"
        },
        "agentPrincipal": {
          "ref": "uuid"
        },
        "generation": {
          "ref": "positive_integer"
        },
        "committedAt": {
          "ref": "millis"
        },
        "files": {
          "type": "array",
          "items": {
            "ref": "file_entry"
          },
          "min": 0,
          "max": 4000,
          "unique": true
        }
      }
    },
    "nullable_manifest": {
      "anyOf": [
        {
          "ref": "manifest"
        },
        {
          "type": "null"
        }
      ]
    },
    "file_request": {
      "type": "object",
      "required": {
        "generation": {
          "ref": "positive_integer"
        },
        "path": {
          "ref": "cloud_home_path"
        }
      }
    },
    "file_response": {
      "type": "object",
      "required": {
        "generation": {
          "ref": "positive_integer"
        },
        "path": {
          "ref": "cloud_home_path"
        },
        "sha256": {
          "ref": "sha256"
        },
        "content": {
          "ref": "standard_base64"
        }
      }
    },
    "validation_subject": {
      "enum": [
        "manifest",
        "file_binding"
      ]
    },
    "validation_violation": {
      "enum": [
        "path",
        "duplicate_path",
        "total_size",
        "content_base64",
        "content_digest",
        "generation_binding",
        "path_binding",
        "manifest_binding"
      ]
    },
    "json_value": {
      "anyOf": [
        {
          "type": "object",
          "additional": {
            "ref": "json_value"
          }
        },
        {
          "type": "array",
          "items": {
            "ref": "json_value"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorization_case": {
      "type": "object",
      "required": {
        "caseId": {
          "type": "string",
          "min": 1,
          "max": 80,
          "pattern": "[a-z][a-z0-9_-]*"
        },
        "ownerMatches": {
          "type": "boolean"
        },
        "liveCloudEnrollment": {
          "type": "boolean"
        },
        "currentOwnerMacV2Lease": {
          "type": "boolean"
        },
        "expected": {
