        "committedPath": {
          "type": "string",
          "min": 1,
          "max": 1024
        },
        "apiPath": {
          "anyOf": [
            {
              "ref": "cloud_home_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "included": {
          "type": "boolean"
        }
      }
    }
  },
