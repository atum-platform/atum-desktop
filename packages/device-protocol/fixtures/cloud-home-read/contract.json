  "semantic_rules": [
    {
      "id": "committed_only",
      "rule": "manifest is the latest committed generation; staging or orphan object-store data is never visible"
    },
    {
      "id": "path",
      "rule": "only USER.md and regular files below memories/ or skills/; relative POSIX; no backslash, NUL, empty, dot, dot-dot, dot-prefixed, directory, symlink, or non-regular entry"
    },
    {
      "id": "bounds",
      "rule": "after hermes-prefix stripping and allowlist projection: at most 4000 unique API paths, 512 UTF-8 bytes per path, 8 MiB per file, and 64 MiB cumulative plaintext; if that complete projected subset exceeds any read bound, refuse the whole read as matrix_409/home_too_large with no truncation or partial manifest"
    },
    {
      "id": "namespace",
      "rule": "committed manifest paths are rooted at hermes/; expose HERMES_HOME-relative API paths by stripping exactly one leading hermes/ and include only allowed USER.md, memories/**, or skills/** entries; file lookup re-adds that exact prefix"
    },
    {
      "id": "immutable_binding",
      "rule": "file generation, path, size and digest bind the exact immutable committed manifest; never substitute the current generation after manifest read"
    },
    {
      "id": "plaintext_digest",
      "rule": "response sha256 is lowercase SHA-256 of decoded standard-base64 plaintext and matches the committed manifest entry"
    },
    {
      "id": "authorization",
      "rule": "allow only authenticated owner plus owned agent live cloud enrollment plus one current owner Mac v2 lease holding that agent; caller cannot nominate a Mac or term"
    },
    {
      "id": "privacy",
      "rule": "foreign agent or home existence is not disclosed; no object keys, encryption material, lease data, credentials, prompts, unrelated files, or content/path/digest logging"
    },
    {
      "id": "one_way",
      "rule": "read only cloud-to-Mac; no upload, delete, list-other-generation, merge, or writeback surface"
    },
    {
      "id": "path_collision",
      "rule": "API paths are byte-exact and case-sensitive; a consumer that detects two distinct paths colliding under its target filesystem semantics must abort the whole hydration rather than overwrite, normalize, or pick one"
    }
  ],
  "rollout": {
    "contract_first": "both manifest and file routes remain unavailable until implemented and enabled together",
    "absent_capability": "404, 405, or 501 remains the desktop not-shipped outcome; other failures are closed and never partial",
    "over_bound_home": "matrix_409/home_too_large is stable and covers the complete allowed projection; never truncate, page, or mislabel it as temporary unavailability",
    "activation": "production enablement requires explicit owner go and serialized production receipts"
  },
