    "conformance": {
      "description": "Worked policy and state-machine examples; not a wire payload.",
      "forbidden_fields": [
        "leaseToken",
        "accessToken",
        "refreshToken",
        "credential",
        "password"
      ]
    },
    "interim_to_owner_room": {
      "description": "An interim remark from the agent in its private chat with the owner: an ordinary agent message that is not the answer.",
      "forbidden_fields": [
        "io.atum.result",
        "io.atum.progress",
        "leaseToken",
        "accessToken",
        "refreshToken",
        "token",
