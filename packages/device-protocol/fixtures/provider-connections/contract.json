{
  "contract_id": "atum.provider-connections",
  "version": 1,
  "status": "frozen",
  "pack_files": [
    "README.md",
    "contract.json",
    "fixtures/chat-provider.request.json",
    "fixtures/chat-secret.response.json",
    "fixtures/chat-stream.request.json",
    "fixtures/chat.request.json",
    "fixtures/chat.response.json",
    "fixtures/connect-ciphertext.request.json",
    "fixtures/connect-long-key.request.json",
    "fixtures/connect-missing-key.request.json",
    "fixtures/connect-owner.request.json",
    "fixtures/connect-unknown-provider.request.json",
    "fixtures/connect.request.json",
    "fixtures/connection.sequence.json",
    "fixtures/custody-durable.vectors.json",
    "fixtures/custody-fallback.vectors.json",
    "fixtures/custody.vectors.json",
