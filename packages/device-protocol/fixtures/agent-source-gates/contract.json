{
  "contract_id": "atum.agent-source-gates",
  "version": 1,
  "status": "frozen",
  "protocol_release": "0.7.57",
  "row": "Owner 2026-10-29: one account-scoped revisioned snapshot projects the six existing source opt-outs to every host",
  "parameters": {
    "maximum_route_bytes": 4096,
    "maximum_revision": 9007199254740991
  },
  "types": {
    "uuid": {
      "type": "string",
      "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    },
    "revision": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "gates": {
      "type": "object",
      "required": {
        "google": {
          "type": "boolean"
        },
        "folders": {
          "type": "boolean"
        },
        "messages": {
          "type": "boolean"
        },
        "browser": {
          "type": "boolean"
        },
        "location": {
          "type": "boolean"
        },
        "team_spaces": {
          "type": "boolean"
        }
      },
      "optional": {},
      "additional": false
    },
    "snapshot": {
      "type": "object",
      "required": {
        "profile": {
          "const": "atum.agent-source-gates/1"
        },
        "revision": {
          "ref": "revision"
        },
        "gates": {
          "ref": "gates"
        }
      },
      "optional": {},
      "additional": false,
      "maxEncodedBytes": 4096
    },
    "write": {
      "type": "object",
      "required": {
        "profile": {
          "const": "atum.agent-source-gates/1"
        },
        "requestId": {
          "ref": "uuid"
        },
        "expectedRevision": {
          "ref": "revision"
        },
        "gates": {
          "ref": "gates"
        }
      },
      "optional": {},
      "additional": false,
      "maxEncodedBytes": 4096
    },
    "write_conflict": {
      "type": "object",
      "required": {
        "profile": {
          "const": "atum.agent-source-gates/1"
        },
        "error": {
          "const": "revision_conflict"
        },
        "current": {
          "ref": "snapshot"
        }
      },
      "optional": {},
      "additional": false,
      "maxEncodedBytes": 4096
    }
  },
  "directions": {
    "owner_to_platform": {
      "forbidden_fields": [
        "*credential*",
        "*password*",
        "*secret*",
        "*token*"
      ]
    },
    "platform_to_owner": {
      "forbidden_fields": [
        "*credential*",
        "*password*",
        "*secret*",
        "*token*"
      ]
    }
  },
  "messages": {
    "gate.snapshot": {
      "direction": "platform_to_owner",
      "schema": {
        "ref": "snapshot"
      }
    },
    "gate.write": {
      "direction": "owner_to_platform",
      "schema": {
        "ref": "write"
      }
    },
    "gate.write-conflict": {
      "direction": "platform_to_owner",
      "schema": {
        "ref": "write_conflict"
      }
    }
  },
  "invariants": [],
  "state_machines": {},
