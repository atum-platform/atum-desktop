      "type": "string",
      "min": 2,
      "max": 1024,
      "pattern": "![!-~]+"
    },
    "timestamp_ms": {
      "type": "integer",
      "min": 0,
      "max": 9007199254740991
    },
    "event_id": {
      "type": "string",
      "min": 2,
      "max": 512,
      "pattern": "\\$[!-~]+"
    },
    "page_token": {
      "type": "string",
      "min": 1,
      "max": 1536,
      "pattern": "[!-~]+"
    },
    "display_name": {
      "type": "string",
      "min": 1,
      "max": 64
    },
    "room_kind": {
