  "row": "Agent chat awareness: live read-only chat view (owner decision 2026-10-20, awareness-design.md S1)",
  "providers": [
    "Shell POST /api/matrix/v1/cloud/controller/executors/{executorId}/chats (cloud controller credential)",
    "Shell POST /api/matrix/v1/chats (native owner token; the Mac host)"
  ],
  "consumers": [
    "hermes tool atum_chats (cloud host, Mac host)"
  ],
  "parameters": {
    "list_limit_default": 20,
    "list_limit_max": 40,
    "read_limit_default": 20,
    "read_limit_max": 40,
    "search_limit_default": 10,
    "search_limit_max": 20,
    "since_max_ms": 5184000000,
    "query_max_chars": 200,
    "text_max_chars": 1024,
    "preview_max_chars": 160,
    "snippet_max_chars": 240,
    "label_max_chars": 120,
    "name_max_chars": 64,
    "members_max": 5,
    "response_max_bytes": 24576,
    "rate_per_minute": 30
  },
  "types": {
