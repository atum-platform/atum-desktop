          "truncated": {
            "type": "boolean"
          }
        },
        "optional": {
          "next": {
            "ref": "page_token"
          }
        }
      }
    },
    "chats.read.response": {
      "direction": "platform_to_agent",
      "schema": {
        "type": "object",
        "required": {
          "id": {
            "ref": "room_id"
          },
          "label": {
            "type": "string",
            "min": 0,
            "max": 120
          },
          "messages": {
            "type": "array",
            "items": {
              "ref": "message"
            },
            "max": 40
          }
        },
        "optional": {
          "next": {
            "ref": "page_token"
          }
        }
      }
    },
    "chats.search.response": {
      "direction": "platform_to_agent",
      "schema": {
        "type": "object",
        "required": {
          "hits": {
            "type": "array",
            "items": {
              "ref": "hit"
            },
            "max": 20
          }
        }
      }
    },
