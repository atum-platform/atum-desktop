{
  "contract_id": "atum.canonical-room",
  "version": 1,
  "status": "frozen",
  "row": "LA Contract 5: owner-private canonical Matrix room read projections",
  "routes": {
    "GET /api/matrix/v1/apps/{slug}/bot": {
      "status": "contract_first",
      "auth": "owner_mas",
      "cache_control": "no-store",
      "request": "app-bot.status.request",
      "response": "app-bot.status.response",
      "path_binding": "slug_is_resolved_server_side_to_an_active_app; the request schema intentionally names_no_slug_or_identity"
    },
    "GET /api/matrix/v1/agents": {
      "status": "contract_first",
      "auth": "owner_mas",
      "cache_control": "no-store",
      "request": "agents.list.request",
      "response": "agents.list.response"
    },
    "GET /api/matrix/web/v1/agents": {
      "status": "contract_first",
      "auth": "owner_browser",
      "cache_control": "no-store",
      "request": "agents.list.request",
      "response": "agents.list.response",
      "mirror": "exact_same_projection_as_GET_/api/matrix/v1/agents"
    }
  },
  "types": {
    "uuid": {
      "type": "string",
      "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
    },
    "matrix_room_id": {
      "type": "string",
      "min": 4,
      "max": 1024,
      "pattern": "![!-9;-~]+:[!-~]+"
    },
    "json_value": {
      "anyOf": [
        {
          "type": "object",
          "additional": {
            "ref": "json_value"
          }
        },
        {
          "type": "array",
          "items": {
            "ref": "json_value"
          }
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "empty_query": {
      "type": "object",
      "required": {}
    },
    "owner_get_request": {
      "type": "object",
      "required": {
        "method": {
          "const": "GET"
        },
        "query": {
          "ref": "empty_query"
        },
        "body": {
          "type": "null"
        }
      }
    },
    "agents_get_request": {
      "type": "object",
      "required": {
        "method": {
          "const": "GET"
        },
        "query": {
          "type": "object",
          "required": {},
          "additional": {
            "ref": "json_value"
          }
        },
        "body": {
          "ref": "json_value"
        }
      }
    },
    "app_bot_status": {
      "type": "object",
      "required": {
        "profile": {
          "const": "atum.app-bot-status/1"
        },
        "room_id": {
          "anyOf": [
            {
              "ref": "matrix_room_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additional": true
    },
    "agent_row": {
      "type": "object",
      "required": {
        "agentPrincipal": {
          "ref": "uuid"
        },
        "roomId": {
          "anyOf": [
            {
              "ref": "matrix_room_id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additional": true
    },
    "agents_list": {
      "type": "array",
      "min": 0,
      "items": {
        "ref": "agent_row"
      }
    }
  },
  "directions": {
    "owner_to_platform": {
