  "messages": {
    "app-bot.status.request": {
      "direction": "owner_to_platform",
      "schema": {
        "ref": "owner_get_request"
      }
    },
    "app-bot.status.response": {
      "direction": "platform_to_app_owner",
      "schema": {
        "ref": "app_bot_status"
      }
    },
    "agents.list.request": {
      "direction": "agents_ignored_transport",
      "schema": {
        "ref": "agents_get_request"
      }
    },
    "agents.list.response": {
      "direction": "platform_to_agents_owner",
      "schema": {
        "ref": "agents_list"
      }
    }
  },
  "semantics": {
    "room_id": {
      "exact_format": "^![!-9;-~]+:[!-~]+$",
      "utf8_bytes": {
        "min": 4,
        "max": 1024
      },
      "legacy_sibling": "the_existing_app-bot_outcome_input_only_checks_min_3_and_leading_!; canonical_room_output_intentionally_requires_a_full_room_id_with_server_name",
      "null": "no_server_recorded_canonical_mapping; null_never_triggers_discovery_creation_or_fallback",
      "missing": "incompatible_response_not_equivalent_to_null",
      "meaning": "owner_private_routing_metadata_only_not_room_membership_or_authorization_evidence"
    },
    "reads": {
      "identity": "MAS_or_browser_authenticated_owner_principal_is_server_derived; app_bot_rejects_query_or_body_identity; agents_routes_ignore_query_and_body_bytes_so_they_never_select_owner_agent_or_controller",
      "app_bot": "path_slug_resolves_server_side_to_an_active_app; mapping_key_is_authenticated_owner_plus_resolved_app_id",
      "agents": "returns_only_the_owners_active_top_level_agents_in_existing_server_order; roomId_maps_to_agentPrincipal_and_is_required_on_every_top_level_row; when_legacy_principal_is_present_it_equals_agentPrincipal; nested_retired_agents_are_legacy_tombstones_and_must_not_acquire_roomId_or_be_used_as_active_mappings",
      "web_agents": "GET_/api/matrix/web/v1/agents_returns_the_exact_same_owner_projection_and_roomId_field_as_the_native_agents_route",
      "privacy": "no_store; canonical_mapping_addition_exposes_only_room_id_or_null_and_no_controller_app_host_or_public_catalog_surface; existing_app_bot_v1_published_metadata_is_not_respecified",
      "consent": "a_mapping_may_be_returned_before_consent_or_link_readiness_but_never_implies_activation_or_authorization",
      "compatibility": "strict_consumers_must_accept_required_additive_room_id_and_roomId_fields_before_server_emission; older_consumers_are_not_activation_safe"
    },
    "deferred": "LA10 implementation, database migration, and all mapping write authority, repair, backfill, cleanup, room creation, race, retirement, and move behavior; controller backfill remains outside this owner-only contract"
  },
