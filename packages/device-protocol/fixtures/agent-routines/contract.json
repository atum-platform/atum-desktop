  "base": {
    "contract": "atum.agent-routines/1.2",
    "path": "spec/agent-routines/v1.2",
    "sha256": "387e37647b188ef9e0ca1f4e2006172f9e45a067648341d7722859cb75260421",
    "rule": "additive: every 1.2 fixture is carried byte for byte; 1.3 adds the executor command import and its closed results"
  },
  "amendments": [
    "A1: a structurally valid schedule kind the authority does not yet accept on the command route is refused with unsupported_schedule, never dropped, rewritten or reported as invalid",
    "A2: the executor command route gains operation import: a home's old scheduled jobs become paused routines in one atomic call with a durable receipt; jobs the cloud cannot represent are recorded as skipped with a reason, never dropped"
  ],
  "semantics": {
    "interval_schedule": {
      "unit": "elapsed_utc_hours",
      "timezone": "display_only_for_interval_length",
      "first_run_anchor": "accepted_create_time",
      "reanchor": "accepted_resume_false_to_true_or_schedule_or_timezone_change_time",
      "preserved_anchor": "all_other_updates_preserve_nextRunAt",
      "phase_carrier": "stored_nextRunAt",
      "advancement": "from_prior_scheduled_instant_never_completion",
      "missed_slots": "skip_to_earliest_strictly_future_scheduled_instant",
      "bounds": {
        "everyHours": {
          "min": 1,
          "max": 8760,
          "meaning": "one_year_operational_and_recurring_arithmetic_safety_limit; use_once_or_monthly_for_longer_periods"
        }
      },
      "owner_route_activation": "contract_first_until_LA9; emit_interval_only_after_LB8_and_LC7_compatibility",
      "older_consumer_rule": "retain_and_display_unknown_schedule_kinds_as_read_only_unsupported_instead_of_rejecting_the_snapshot"
    },
    "executor_command": {
      "authenticated_binding": "server_derives_owner_assistant_and_agent_from_authenticated_executor_binding",
      "path_binding": "path_executorId_must_equal_authenticated_controllerCloudBinding; body_cannot_override",
      "idempotency": "exact_mutation_replay_returns_same_result; same_requestId_with_different_bytes_conflicts",
      "legacy_gate": "legacyState_remains_visible; create_run_and_enabled_update_are_denied_unless_clear",
      "cron_spawn_guard": "sandbox_consumer_refuses_scheduling_when_current_run_was_cron_spawned; not_an_authority_fence",
      "pause_resume": "full_replacement_update_with_enabled_false_or_true",
      "failure_results": "closed_refused_or_error_result; revision_conflict_includes_current_revision",
      "unsupported_schedule": "create_or_update_whose_schedule_matches_the_schedule_type_but_whose_kind_the_authority_has_not_activated_on_this_route; today_interval_until_LA9_activation; refused_with_the_reason_never_dropped_or_reported_as_invalid; the_consumer_tells_the_owner_and_chooses_a_supported_kind",
      "import": {
        "purpose": "one_time_receipted_move_of_a_homes_old_scheduled_jobs_into_the_routines_list",
        "paused": "every_imported_routine_is_created_enabled_false_whatever_the_home_job_state_was; the_owner_turns_on_the_ones_they_want",
        "legacy_gate": "import_inserts_only_disabled_rows_so_it_is_allowed_while_legacyState_is_present",
        "atomic": "one_call_inserts_every_row_and_the_receipt_or_none",
        "idempotent": "each_homeJobId_is_imported_at_most_once_per_agent; a_repeat_returns_the_first_routineId_and_creates_nothing; same_requestId_replays_the_same_result",
        "skipped": "unsupported_and_invalid_are_final_and_recorded_with_a_note; quota_is_not_recorded_and_may_be_imported_later",
        "enableOnClear": "a_true_flag_enables_that_routine_when_the_home_inventory_next_reports_clear_only_if_it_is_still_disabled_and_unedited; the_flag_is_then_spent",
        "stale_generation": "refused_when_the_home_generation_is_older_than_the_latest_inventory_report",
        "bounds": {
          "jobs": {
            "min": 1,
            "max": 16
          }
        },
        "consumer_rule": "disable_the_home_jobs_named_in_imported_or_final_skipped_only_after_the_result; leave_quota_skipped_jobs_live"
      }
    }
  }
}
