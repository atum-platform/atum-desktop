{
  "steps": [
    {
      "from": "idle",
      "to": "routed",
      "event": "mac_selected"
    },
    {
      "from": "routed",
      "to": "working",
      "event": "work_started"
    },
    {
      "from": "working",
      "to": "waiting_unreachable",
      "event": "device_unreachable"
    },
    {
      "from": "waiting_unreachable",
      "to": "resumed",
      "event": "device_reconnected"
    },
    {
      "from": "resumed",
      "to": "working",
      "event": "work_started"
    },
    {
      "from": "working",
      "to": "ended",
      "event": "turn_ended"
    }
  ]
}
