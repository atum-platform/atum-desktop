  "base": {
    "contract": "atum.agent-presentation/1",
    "path": "spec/agent-presentation/v1",
    "sha256": "4e53e33ff78563548018fec4f17ff5e76b48886b0b9a96e8aef6a48ef8165a0b",
    "rule": "additive: every v1 fixture is carried byte for byte; v1 presentation.snapshot is unchanged and does not acquire placement"
  },
  "amendments": [
    "A1: adds the existing agent-profile list projection only",
    "A2: v1 presentation.snapshot remains unchanged and never exposes placement",
    "A3: placement is a safe server projection, not policy or lease state"
  ],
  "semantics": {
    "profile_list": {
      "title": "canonical_normalized_atum.assistants.title; null_means_absent_and_is_not_a_role_or_authority_claim",
      "failover_order": "server_policy_projected_failover_order_of_cloud_plus_active_device_services_including_disabled_destinations_without_a_disabled_flag",
      "mac_name": "device_service_registry_display_name_not_a_uuid",
      "online": "server_derived_eligible_and_stable",
      "lease_holder": "derived_from_one_current_unexpired_lease_per_agent_placement; at_most_one_true_and_possibly_none",
      "origin_binding": "originPrincipal_names_one_agents_entry_and_originIsMain_equals_that_entries_isMain",
      "native_request_envelope": "native_route_posts_exactly_{originPrincipal,request:profiles.list.request}; caller_names_originPrincipal_but_SQL_reauthorizes_it_under_the_MAS_owner_and_it_is_never_an_authority_grant",
      "controller_request_envelope": "controller_route_posts_profiles.list.request_literally; path_executorId_must_match_the_authenticated_controller_binding",
      "roster_bound": "response_contains_1_to_100_agents; server_implementation_must_cap_or_fail_closed_before_emission",
      "online_scope": "online_is_reachability_only_not_dispatch_authority; a_disabled_destination_can_be_online_and_clients_must_not_infer_selection",
      "hidden": "never_expose_disabled_flags_policy_revision_destination_executor_device_service_or_matrix_device_ids_lease_tokens_or_expiry_internal_reasons_or_diagnostics_credentials_endpoints_or_secrets",
      "contract_first": "later_implementation_updates_the_strict_desktop_shared_parser_with_LB_before_the_server_emits_fields; no_route_migration_or_runtime_activation_now",
      "errors": "surrounding_denied_invalid_and_unavailable_forms_remain_outside_these_success_envelopes"
    },
    "request_fence": "request_cannot_supply_title_placement_online_lease_holder_order_owner_role_main_executor_or_device_fields_or_secret_shaped_fields",
    "placement": {
      "exact": "{failoverOrder:[cloud|mac]}",
      "failover_order_bounds": {
        "min": 1,
        "max": 65
      },
      "duplicate_mac_display_names": "allowed; no_canonical_unique_constraint",
      "cloud_cardinality": "exactly_one_cloud_entry_per_failoverOrder"
    }
  }
}
